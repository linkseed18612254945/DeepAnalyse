# LLM Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Search provider: "tavily" or "bing"
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-...
BING_API_KEY=

# Retrieval settings
MAX_RETRIEVAL_ROUNDS=5
MAX_SEARCH_RESULTS_PER_QUERY=10

# Neo4j (optional — in-memory graph used if unavailable)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Server
DEBUG=false
# HOST defaults to 127.0.0.1 on Windows, 0.0.0.0 on Linux/macOS.
# Override here if needed (e.g. 0.0.0.0 for Docker on Windows).
# HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
